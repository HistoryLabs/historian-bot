{
  "name": "historian-bot",
  "version": "5.0.0",
  "private": true,
  "description": "Historian Discord bot, running on Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply historian --local",
    "register-commands": "node --env-file=.dev.vars --experimental-strip-types scripts/register-commands.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HistoryLabs/historian-bot.git"
  },
  "author": "Angoose",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/HistoryLabs/historian-bot/issues"
  },
  "homepage": "https://github.com/HistoryLabs/historian-bot#readme",
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261024.1",
    "discord-api-types": "^0.38.57",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261019.1": true
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0"
  }
}
