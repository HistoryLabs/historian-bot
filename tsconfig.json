{
    "compilerOptions": {
        "target": "es2024",
        "lib": ["es2024"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
        "strict": true,
        "noEmit": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true
    },
    "include": ["src", "test"]
}
